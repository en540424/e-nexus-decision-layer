{
  "$id": "edl/claude-code/model-route",
  "title": "ModelRoute",
  "description": "schema-only + rules。Claude Code Harness の Model / Effort Router。Advisor正本§2-2（13条件）・Sonnet First・Fable特別承認制を rules ファイルへ写した。Fable は決して auto にならない。",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["task_size"],
      "properties": {
        "task_size": { "type": "string", "enum": ["S", "M", "L"] },
        "touches_harness": { "type": "boolean", "description": ".claude/ や 01_harness/ 等ハーネス自体の変更か" },
        "touches_billing_or_auth_or_db": { "type": "boolean" },
        "cross_repo": { "type": "boolean" },
        "design_decision": { "type": "boolean", "description": "複数の妥当な方針があり選択が全体へ影響するか" },
        "repeated_failure": { "type": "boolean", "description": "同じ修正を繰り返して解決しないか" },
        "human_requested_model": { "type": ["string", "null"] },
        "__mock": { "type": "object" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["executor_model", "consult_advisor", "effort"],
      "additionalProperties": false,
      "properties": {
        "executor_model": { "type": "string", "enum": ["sonnet", "opus"] },
        "consult_advisor": { "type": "boolean" },
        "effort": { "type": "string", "enum": ["low", "medium", "high"] },
        "human_review_required": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
