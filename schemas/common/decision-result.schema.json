{
  "$id": "edl/common/decision-result",
  "title": "DecisionResult",
  "description": "Decision Layer が返す共通結果。outcome の中身は decision_type 固有 schema で別途検証される。承認を意味するキー（approved 等）は policies/safety/human-only.json により構造上存在できない。",
  "type": "object",
  "required": ["decision_id", "decision_type", "application_id", "project_id", "outcome", "confidence", "tier", "resolved_by", "human_gate", "fallback", "timestamp"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "decision_type": { "type": "string" },
    "application_id": { "type": "string" },
    "project_id": { "type": "string" },
    "tenant": { "type": ["string", "null"] },
    "outcome": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "tier": { "type": "string", "enum": ["auto", "review", "human"] },
    "resolved_by": { "type": "string" },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "rationale": { "type": ["string", "null"] },
    "human_gate": {
      "type": "object",
      "required": ["required", "preserved"],
      "properties": {
        "required": { "type": "boolean" },
        "preserved": { "type": "boolean", "const": true },
        "reason": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["occurred", "trace"],
      "properties": {
        "occurred": { "type": "boolean" },
        "trace": {
          "description": "attempt record の配列（1要素 = adapter.decide() 1回）。adapter/status に加え provider/model/route/confidence/tier/reason/ms/latency_ms/networked/usage_known/input_tokens/output_tokens/estimated_cost_usd_micros/retry_count/final/continue_reason を持つ（src/core/fallback.mjs 参照）。final が human でも途中の real provider の usage はここに残る",
          "type": "array",
          "items": { "type": "object", "required": ["adapter", "status"] }
        },
        "skipped": { "type": "array" }
      }
    },
    "candidates_considered": { "type": "array", "items": { "type": "string" } },
    "thresholds": { "type": "object" },
    "timestamp": { "type": "string" },
    "usage": {
      "description": "metering record（schema 検証後に付与される）。top-level の provider/model/tokens/cost は final resolver の usage、attempts[] は全 attempt、usage_total は attempts の合計（final 分を含む。top-level と足すと二重計上）。src/usage/metering.mjs 参照",
      "type": "object"
    }
  }
}
