# E-NEXUS Decision Layer — 環境変数「名」のみ。実値はHumanがローカルの .env へ設定する（repoへ保存しない）
# Jev（TypeSafe AI）Adapter用。未設定なら Jev Adapter は unavailable として扱われ、Mock / Rules / Human へフォールバックする
# 値は公式SDK（@typesafe-ai/sdk）の TYPESAFE_API_KEY に相当する。SDKは使わないが名称の対応関係として記載
JEV_API_KEY=
JEV_API_BASE_URL=
# Jev への到達経路。direct（TypeSafe Direct）/ vercel（Vercel AI Gateway）/ cloudflare（Cloudflare経由）。省略時 direct。direct は実装済み（2026-09-19）。vercel / cloudflare は予約のみ（未実装）
JEV_PROVIDER=direct
# Jev モデルID。省略時 jev-latest（公式stable alias）。jev-preview 等へ切替える場合のみ設定
JEV_MODEL=
# Direct Provider の1試行あたりタイムアウト（ミリ秒）。省略時 10000
JEV_TIMEOUT_MS=
# 明示的に true にしない限りネットワーク送信を行わない（デフォルト false）
EDL_ALLOW_NETWORK=false
# usage metering の保存先（省略時 data/usage/usage.jsonl）
EDL_USAGE_PATH=

# --- JEV_PROVIDER=vercel（Vercel AI Gateway経由）専用。2026-09-19実装。npm optionalDependencies の
# "ai"（AI SDK v7、Node.js 22+ 必須）が別途 `npm install` されていないとこの経路は使えない ---
# Vercel AI Gateway の API キー（vck_ から始まる。Vercelダッシュボードで発行）
AI_GATEWAY_API_KEY=
# Gateway の baseURL を変える場合のみ設定（省略時 SDK既定の https://ai-gateway.vercel.sh/v4/ai）
AI_GATEWAY_BASE_URL=
# Gateway 上のモデルID。省略時 typesafe-ai/<JEV_MODEL>（既定なら typesafe-ai/jev-latest）。
# 完全なIDで固定したい場合のみ設定（例: typesafe-ai/jev-preview）
JEV_VERCEL_MODEL=
# true で Vercel AI Gateway の Zero Data Retention を有効化（providerOptions.gateway.zeroDataRetention）
JEV_ZDR=false
