{
  "$comment": "Advisorモデル運用ルール_正本 §0（モデル運用の唯一の正本。2026-10-01 改訂・同日整合修正：モデル×Effort の 2 軸・作業の中心で選ぶ）と §2-2（Advisor 13条件）・最小ハーネス §15-3（危険条件）を rules 化した参考値。採否は決めない（Claude Code 本体の実モデルは Human の /model・settings.json が正）。読解・比較・横断監査が中心なら fable を返す（2026-10-01 整合修正で旧「Human 指定時のみ」を廃止。課金は Advisor正本§0-6）。work_center：implementation＝実装が中心→sonnet／design-judgment＝設計・判断が中心（設計しながら実装する自律構築を含む）→opus／reading-comparison-audit＝読解・比較・横断監査が中心→fable（通常監査 high・ssot_conflict=true なら xhigh。Advisor正本§0-3）。work_center が無い旧入力（task_size だけ）は従来どおり sonnet（実装が中心とみなす）。",
  "rules": [
    { "id": "human-requested-model", "when": { "human_requested_model": { "exists": true } }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": true, "note": "Human が明示指定したモデルは Human 側の /model・設定で反映する（Decision Layer は変更しない。executor_model の値は placeholder）" } },
    { "id": "audit-center-ssot-conflict", "when": { "work_center": "reading-comparison-audit", "ssot_conflict": true }, "outcome": { "executor_model": "fable", "consult_advisor": false, "effort": "xhigh", "human_review_required": false, "note": "Advisor正本§0-2（読解・比較・横断監査→Fable 5.1）＋§0-3（SSOT 衝突・重大監査＝XHigh）。Max は §0-3 の厳格条件を満たすときだけ Human 判断で" } },
    { "id": "audit-center", "when": { "work_center": "reading-comparison-audit" }, "outcome": { "executor_model": "fable", "consult_advisor": false, "effort": "high", "human_review_required": false, "note": "Advisor正本§0-2（読解・比較・横断監査→Fable 5.1）＋§0-3（通常の広範囲監査＝Medium／High。資料量だけで XHigh にしない）" } },
    { "id": "design-center-harness", "when": { "work_center": "design-judgment", "touches_harness": true }, "outcome": { "executor_model": "opus", "consult_advisor": false, "effort": "high", "human_review_required": true, "note": "Advisor正本§0-2（設計・判断→Opus）＋§2-2 条件13（ハーネス変更）" } },
    { "id": "design-center", "when": { "work_center": "design-judgment" }, "outcome": { "executor_model": "opus", "consult_advisor": false, "effort": "high", "human_review_required": false, "note": "Advisor正本§0-2：設計・判断が中心（自律構築を含む）→ Opus／High" } },
    { "id": "harness-change-needs-advisor", "when": { "touches_harness": true }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": true, "note": "Advisor§2-2 条件13" } },
    { "id": "billing-auth-db-needs-advisor", "when": { "touches_billing_or_auth_or_db": true }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": true, "note": "Advisor§2-2 条件3 / 最小ハーネス§15-3" } },
    { "id": "design-decision-needs-advisor", "when": { "design_decision": true }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": false, "note": "Advisor§2-2 条件1・6（実装が中心のセッションで設計判断が出た＝Sonnet が Advisor へ相談）" } },
    { "id": "repeated-failure-needs-advisor", "when": { "repeated_failure": true }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": false, "note": "Advisor§2-2 条件4・12" } },
    { "id": "cross-repo-L", "when": { "task_size": "L", "cross_repo": true }, "outcome": { "executor_model": "sonnet", "consult_advisor": true, "effort": "high", "human_review_required": false, "note": "Advisor§2-2 条件11" } },
    { "id": "L-default", "when": { "task_size": "L" }, "outcome": { "executor_model": "sonnet", "consult_advisor": false, "effort": "high", "human_review_required": false, "note": "実装が中心（Advisor正本§0-2）。Plan 必須（最小ハーネス§15-2）" } },
    { "id": "M-default", "when": { "task_size": "M" }, "outcome": { "executor_model": "sonnet", "consult_advisor": false, "effort": "high", "human_review_required": false, "note": "実装が中心（Advisor正本§0-2）" } },
    { "id": "S-default", "when": { "task_size": "S" }, "outcome": { "executor_model": "sonnet", "consult_advisor": false, "effort": "medium", "human_review_required": false, "note": "実装が中心（Advisor正本§0-2）＋§0-3（S＝Medium）。Plan 不要" } }
  ]
}
