{
  "$comment": "Agent／consumer が Gateway の envelope を受け取った後の扱い（Agent Integration Contract・Vault MA-32-5・2026-10-02）。言語非依存の cases で、Node（consumer-kit/node/interpret.mjs）と Python（consumer-kit/python/enexus_interpret.py）の参照実装が同じ結果を返すことを tests/agent-interpretation.test.mjs が検査する。next の語彙：candidate（tier auto＝次の段階の『候補』として使ってよい。許可ではない）／review（Advisor 相談か Human 確認へ）／human（Human へ判断を返す）／stop（その処理を進めない＝failure policy deny）。どの next でも approval は常に false（Decision Layer の結果は承認ではない。有料実行・公開・送信・deploy は既存の Human-only ゲートを通る）。緩める方向の解釈はしない：tier auto でも human_gate.required・decision の欠落・環境の不一致・不明な tier・壊れた envelope は human。Knowledge の status（unavailable 等）を Agent が補完・格上げしない（decision をそのまま読む）。",
  "version": "1",
  "cases": [
    { "name": "auto は候補（許可ではない）", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false }, "outcome": { "recommended_executor": "claude-code" } }, "gateway": { "environment": "dev" } }, "expect": { "next": "candidate", "approval": false } },
    { "name": "review は Advisor／Human 確認", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "review", "human_gate": { "required": false } }, "gateway": { "environment": "dev" } }, "expect": { "next": "review", "approval": false } },
    { "name": "human tier は Human", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "human", "human_gate": { "required": true, "reason": "x" } }, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } },
    { "name": "auto でも human_gate.required なら Human（緩めない）", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": true } }, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } },
    { "name": "Knowledge unavailable の auto はそのまま（Agent が Knowledge を補完しない・格上げもしない）", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false }, "knowledge": { "status": "unavailable", "reason": "timeout" } }, "gateway": { "environment": "dev" } }, "expect": { "next": "candidate", "approval": false } },
    { "name": "ok:false・failure human-required は Human", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": false, "decision": null, "error": { "code": "GATEWAY_TIMEOUT" }, "failure": { "policy": "human-required", "proceed_automatically": false } }, "expect": { "next": "human", "approval": false } },
    { "name": "ok:false・failure deny は止める", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": false, "decision": null, "error": { "code": "ENGINE_ERROR" }, "failure": { "policy": "deny", "proceed_automatically": false } }, "expect": { "next": "stop", "approval": false } },
    { "name": "ok:false で failure が無い・不明な policy は Human（fail-closed）", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": false, "decision": null, "error": { "code": "X" }, "failure": { "policy": "allow" } }, "expect": { "next": "human", "approval": false } },
    { "name": "ok:true で decision が無い＝Human", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": null, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } },
    { "name": "環境が違う＝Human（結果を使わない）", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false } }, "gateway": { "environment": "production" } }, "expect": { "next": "human", "approval": false } },
    { "name": "環境が欠落＝Human", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false } } }, "expect": { "next": "human", "approval": false } },
    { "name": "未知の tier＝Human", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "go", "human_gate": { "required": false } }, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } },
    { "name": "contract_version が違う＝Human", "expected_environment": "dev", "envelope": { "contract_version": "2", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false } }, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } },
    { "name": "envelope が object でない＝Human", "expected_environment": "dev", "envelope": "not an envelope", "expect": { "next": "human", "approval": false } },
    { "name": "envelope が null＝Human", "expected_environment": "dev", "envelope": null, "expect": { "next": "human", "approval": false } },
    { "name": "outcome に承認を名乗る key があっても承認にしない", "expected_environment": "dev", "envelope": { "contract_version": "1", "ok": true, "decision": { "tier": "auto", "human_gate": { "required": false }, "outcome": { "approved": true } }, "gateway": { "environment": "dev" } }, "expect": { "next": "human", "approval": false } }
  ]
}
